# Copy to .env (never commit .env). The app works fully WITHOUT any of these.
#
# Where the SQLite database file lives (default: data/edupulse.db)
# EDUPULSE_DB_PATH=data/edupulse.db
#
# =========================================================================
# Learnlytics AI Tutor Configuration
# =========================================================================
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=25.0
# OPENAI_MAX_TOKENS=800
#
# OPTIONAL legacy wording polish
# EDUPULSE_USE_LLM=0
# ANTHROPIC_API_KEY=your-key-here
# EDUPULSE_LLM_MODEL=claude-sonnet-5-5
